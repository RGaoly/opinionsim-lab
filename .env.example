# Generate with: python setup_secrets.py
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_RANDOM_VALUE
DATABASE_URL=postgresql://opinionsim:REPLACE_WITH_SAME_PASSWORD@db:5432/opinionsim
APP_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
ALLOW_PAID_API=false
API_ALLOWED_HOSTS=dashscope.aliyuncs.com,api.deepseek.com,api.openai.com
# Set DOMAIN only for public HTTPS deployment with compose.https.yaml
DOMAIN=lab.example.org
